#!/usr/bin/env python3
"""WebKitGTK helper. Separate process so a crash cannot kill the kiosk."""

from __future__ import annotations

import faulthandler
import os
import sys


def _reopen_closed_stdio() -> None:
    for fd, flags in ((0, os.O_RDONLY), (1, os.O_WRONLY), (2, os.O_WRONLY)):
        try:
            os.fstat(fd)
        except OSError:
            null = os.open(os.devnull, flags)
            if null != fd:
                os.dup2(null, fd)
                os.close(null)


_reopen_closed_stdio()
faulthandler.enable(all_threads=True)

os.environ["GSK_RENDERER"] = "cairo"
os.environ["WEBKIT_SKIA_ENABLE_CPU_RENDERING"] = "1"
os.environ["LIBGL_ALWAYS_SOFTWARE"] = "1"
for _k in (
    "WEBKIT_DISABLE_DMABUF_RENDERER",
    "WEBKIT_DMABUF_RENDERER_FORCE_SHM",
    "WEBKIT_DISABLE_COMPOSITING_MODE",
):
    os.environ.pop(_k, None)
os.environ.setdefault("GDK_BACKEND", "wayland")
os.environ.setdefault("GTK_A11Y", "none")
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ.setdefault("GSETTINGS_BACKEND", "memory")
os.environ.setdefault("GTK_USE_PORTAL", "0")

HERE = os.path.dirname(os.path.abspath(__file__))
CANDIDATES = (
    HERE,
    "/usr/share/firstboot/python",
)
for path in CANDIDATES:
    if os.path.isdir(os.path.join(path, "firstboot")):
        if path not in sys.path:
            sys.path.insert(0, path)
        break

print("firstboot-browser: starting", file=sys.stderr, flush=True)

from firstboot.browser import drop_process_caps, run_browser  # noqa: E402

drop_process_caps()
print("firstboot-browser: caps dropped", file=sys.stderr, flush=True)

if __name__ == "__main__":
    try:
        raise SystemExit(run_browser())
    except Exception:
        import traceback

        traceback.print_exc(file=sys.stderr)
        sys.stderr.flush()
        raise
