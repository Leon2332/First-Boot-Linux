#!/usr/bin/env python3
"""Persist the live-session language on the payload."""

from __future__ import annotations

import os
import sys


HERE = os.path.dirname(os.path.abspath(__file__))
CANDIDATES = (
    HERE,
    "/usr/share/firstboot/python",
)
for path in CANDIDATES:
    if os.path.isdir(os.path.join(path, "firstboot")):
        if path not in sys.path:
            sys.path.insert(0, path)
        break

from firstboot.i18n import (  # noqa: E402
    ID_RE,
    resolve_language,
    write_language_file,
)


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if len(args) != 2:
        print("usage: set-language PAYLOAD_ROOT LANG", file=sys.stderr)
        return 2
    root, lang = args
    if os.geteuid() != 0:
        print("set-language: must run as root", file=sys.stderr)
        return 1
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        print("set-language: payload directory missing", file=sys.stderr)
        return 2
    if not ID_RE.fullmatch(lang.strip().casefold().replace("_", "-")):
        print("set-language: invalid language id", file=sys.stderr)
        return 2
    write_language_file(root, resolve_language(lang))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
