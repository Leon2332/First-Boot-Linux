#!/usr/bin/env python3
"""System details helper. Separate process so it stacks with other xdg clients."""

from __future__ import annotations

import faulthandler
import os
import sys


def _reopen_closed_stdio() -> None:
    for fd, flags in ((0, os.O_RDONLY), (1, os.O_WRONLY), (2, os.O_WRONLY)):
        try:
            os.fstat(fd)
        except OSError:
            null = os.open(os.devnull, flags)
            if null != fd:
                os.dup2(null, fd)
                os.close(null)


_reopen_closed_stdio()
faulthandler.enable(all_threads=True)

os.environ.setdefault("GDK_BACKEND", "wayland")
os.environ.setdefault("GTK_A11Y", "none")
os.environ.setdefault("NO_AT_BRIDGE", "1")
os.environ.setdefault("GTK_USE_PORTAL", "0")
os.environ.pop("GSETTINGS_BACKEND", None)

HERE = os.path.dirname(os.path.abspath(__file__))
CANDIDATES = (
    HERE,
    "/usr/share/firstboot/python",
)
for path in CANDIDATES:
    if os.path.isdir(os.path.join(path, "firstboot")):
        if path not in sys.path:
            sys.path.insert(0, path)
        break

print("firstboot-sysinfo: starting", file=sys.stderr, flush=True)

from firstboot.browser import drop_process_caps  # noqa: E402
from firstboot.sysinfo import run_sysinfo  # noqa: E402

drop_process_caps()
print("firstboot-sysinfo: caps dropped", file=sys.stderr, flush=True)

if __name__ == "__main__":
    try:
        raise SystemExit(run_sysinfo())
    except Exception:
        import traceback

        traceback.print_exc(file=sys.stderr)
        sys.stderr.flush()
        raise
