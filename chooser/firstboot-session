#!/bin/sh
# Start the First Boot chooser under labwc. Used as the tty1 login session.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=FirstBoot
export FIRSTBOOT_KIOSK=1
export GDK_BACKEND=wayland
export GTK_A11Y=none
export NO_AT_BRIDGE=1
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-0}"

LABWC_DIR=/usr/share/firstboot/labwc
PYDIR=/usr/share/firstboot/python

note() {
  echo "firstboot-session: $*" >&2
  if [ -w /dev/kmsg ]; then
    printf '<6>firstboot-session: %s\n' "$*" >/dev/kmsg
  fi
  logger -t firstboot-session "$*" || true
}

drop_to_shell() {
  note "$*"
  export FIRSTBOOT_NO_KIOSK=1
  exec /bin/bash
}

if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
  XDG_RUNTIME_DIR=/tmp/firstboot-runtime
  mkdir -p "$XDG_RUNTIME_DIR" || drop_to_shell "cannot create $XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  export XDG_RUNTIME_DIR
  note "using $XDG_RUNTIME_DIR"
fi

if [ -f "$PYDIR/firstboot/render.py" ] && command -v python3 >/dev/null 2>&1; then
  eval "$(PYTHONPATH="$PYDIR" python3 -c 'from firstboot.render import emit_session_env; emit_session_env()')"
fi
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export WLR_RENDERER="${WLR_RENDERER:-pixman}"
note "GSK_RENDERER=$GSK_RENDERER WLR_RENDERER=$WLR_RENDERER"

if ! command -v labwc >/dev/null 2>&1; then
  drop_to_shell "labwc not found"
fi

if ! command -v firstboot-chooser >/dev/null 2>&1; then
  drop_to_shell "firstboot-chooser not found"
fi

if [ ! -d "$LABWC_DIR" ]; then
  drop_to_shell "labwc config missing ($LABWC_DIR)"
fi

note "starting labwc + chooser"

note "exec labwc"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  dbus-run-session -- labwc -V -C "$LABWC_DIR" -S /usr/bin/firstboot-chooser
else
  labwc -V -C "$LABWC_DIR" -S /usr/bin/firstboot-chooser
fi
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi
drop_to_shell "labwc exited $status"
