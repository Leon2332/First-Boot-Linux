#!/bin/sh
# Start cage with the First Boot chooser. Used as the tty1 login session.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=FirstBoot
export GDK_BACKEND=wayland

drop_to_shell() {
  echo "firstboot-session: $*" >&2
  logger -t firstboot-session "$*" || true
  export FIRSTBOOT_NO_KIOSK=1
  exec /bin/bash
}

if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
  drop_to_shell "no usable XDG_RUNTIME_DIR (logind session missing)"
fi

if ! command -v cage >/dev/null 2>&1; then
  drop_to_shell "cage not found"
fi

if ! command -v firstboot-chooser >/dev/null 2>&1; then
  drop_to_shell "firstboot-chooser not found"
fi

logger -t firstboot-session "starting cage + chooser" || true

# -s: allow VT switch for field debug (Ctrl+Alt+F2)
# -d: no client-side decorations
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  dbus-run-session -- cage -s -d -- firstboot-chooser
else
  cage -s -d -- firstboot-chooser
fi
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi
drop_to_shell "cage exited $status"
