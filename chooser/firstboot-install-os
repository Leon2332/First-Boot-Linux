#!/usr/bin/env python3
"""Privileged customer OS install for First Boot Linux."""

from __future__ import annotations

import os
import sys


HERE = os.path.dirname(os.path.abspath(__file__))
CANDIDATES = (
    HERE,
    "/usr/share/firstboot/python",
)
for path in CANDIDATES:
    if os.path.isdir(os.path.join(path, "firstboot")):
        if path not in sys.path:
            sys.path.insert(0, path)
        break

from firstboot.osinstall import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
