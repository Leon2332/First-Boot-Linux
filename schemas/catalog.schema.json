{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstboot.local/schemas/catalog.schema.json",
  "title": "First Boot Linux shop catalog",
  "description": "Per-shop catalog.json on the USB payload. Self-contained; the chooser does not read official-catalog.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recommended", "catalog"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "recommended": {
      "type": "array",
      "description": "Chooser grid. Each entry must have at least one local edition.",
      "items": { "$ref": "#/$defs/distro" }
    },
    "catalog": {
      "type": "array",
      "description": "Download-only extras. Ids must not also appear in recommended.",
      "items": { "$ref": "#/$defs/distro" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "distro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "tagline",
        "description",
        "family",
        "install",
        "editions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": ["ubuntu", "mint", "fedora", "debian", "suse", "other"]
        },
        "install": {
          "type": "string",
          "enum": [
            "ubuntu-autoinstall",
            "mint",
            "fedora-kickstart",
            "debian-preseed"
          ]
        },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edition" }
        }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "default",
        "local",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "default": { "type": "boolean" },
        "local": { "type": "boolean" },
        "file": {
          "type": "string",
          "pattern": "^images/[^/\\\\]+\\.(iso|img)$",
          "description": "Required when local is true. Relative to the payload root."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Required when local is false."
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "local": { "const": true } },
            "required": ["local"]
          },
          "then": { "required": ["file"] }
        },
        {
          "if": {
            "properties": { "local": { "const": false } },
            "required": ["local"]
          },
          "then": { "required": ["url"] }
        }
      ]
    }
  }
}
