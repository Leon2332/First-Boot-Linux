{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstboot.local/schemas/official-catalog.schema.json",
  "title": "First Boot Linux official catalog",
  "description": "Creator menu of distros we support. Not written to the USB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "distros"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Date this catalog was last edited (YYYY-MM-DD)."
    },
    "distros": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/distro" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "description": "64 lowercase hex, or null until the ISO is pinned.",
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "url": {
      "description": "Direct ISO URL, or null until pinned.",
      "anyOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "distro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "tagline",
        "description",
        "family",
        "redistributable",
        "install",
        "can_stage",
        "suggested_default",
        "editions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": ["ubuntu", "mint", "fedora", "debian", "suse", "windows", "bsd", "other"]
        },
        "redistributable": {
          "type": "boolean",
          "description": "We may copy an official edition onto payload/images/. False for licenses that forbid redistribution (e.g. MS Windows). Independent of install."
        },
        "install": {
          "description": "Install driver id, or null if we cannot install this distro yet. windows and freebsd are reserved; no driver yet.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ubuntu-2604",
                "ubuntu-autoinstall",
                "mint-223",
                "mint",
                "fedora-44-plasma",
                "fedora-kickstart",
                "debian-preseed",
                "windows",
                "freebsd"
              ]
            },
            { "type": "null" }
          ]
        },
        "can_stage": {
          "type": "boolean",
          "description": "Creator may copy an edition ISO to payload/images/. True only when install is set and redistributable is true."
        },
        "suggested_default": {
          "type": "boolean",
          "description": "Pre-tick in the creator. Requires install. May be true when redistributable is false (download-only recommended)."
        },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edition" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redistributable": { "const": false } },
            "required": ["redistributable"]
          },
          "then": {
            "properties": { "can_stage": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "can_stage": { "const": true } },
            "required": ["can_stage"]
          },
          "then": {
            "properties": {
              "redistributable": { "const": true },
              "install": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "default",
        "filename",
        "url",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "default": {
          "type": "boolean",
          "description": "Featured on the recommended card. Exactly one true per distro."
        },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.(iso|img)$",
          "description": "Basename only; written to payload/images/."
        },
        "url": { "$ref": "#/$defs/url" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  }
}
