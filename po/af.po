msgstr "Klaar"

msgid "Checking the image…"
msgstr "Kontroleer die beeld…"

msgid "Preparing {name}…"
msgstr "Berei {name} voor…"

msgid "Restarting to install {name}…"
msgstr "Herbegin om {name} te installeer…"

msgid "{name} will install after restart. This computer will be erased."
msgstr "{name} sal ná herbegin installeer. Hierdie rekenaar sal uitgevee word."

msgid "Downloading…"
msgstr "Laai af…"

msgid "Ready"
msgstr "Gereed"

msgid "Download is not available yet ({name})."
msgstr "Aflaai is nog nie beskikbaar nie ({name})."

msgid "Download finished, but the image is missing."
msgstr "Aflaai is klaar, maar die beeld ontbreek."

msgid "{name} install is not available yet."
msgstr "{name}-installasie is nog nie beskikbaar nie."

msgid "No internal disk to install to."
msgstr "Geen interne skyf om op te installeer"

msgid "Install to this device is only available when booted from USB."
msgstr "Installeer op hierdie toestel is slegs beskikbaar wanneer van USB af gelaai is."

msgid "This USB does not look like a First Boot install drive."
msgstr "Hierdie USB lyk nie na ’n First Boot-installasiestokkie nie."

msgid "Not running from a First Boot USB."
msgstr "Loop nie van ’n First Boot-USB nie."

msgid "Cannot install."
msgstr "Kan nie installeer nie."

msgid "Enter a name."
msgstr "Voer ’n naam in."

msgid "Username must start with a letter and use only a–z, 0–9, _ or -."
msgstr "Gebruikersnaam moet met ’n letter begin en slegs a–z, 0–9, _ of - gebruik."

msgid "Computer name must be letters, numbers, and hyphens."
msgstr "Rekenaarnaam moet letters, syfers en koppeltekens wees."

msgid "Password must be at least 6 characters."
msgstr "Wagwoord moet minstens 6 karakters wees."

msgid "Password cannot contain line breaks."
msgstr "Wagwoord mag nie reëlbreektekens bevat nie."

msgid "This computer needs about {size} of memory to install {name} from the internal disk."
msgstr "Hierdie rekenaar het sowat {size} geheue nodig om {name} van die interne skyf af te installeer."

msgid "Internal disk is too small ({have}; need {need})."
msgstr "Interne skyf is te klein ({have}; {need} word benodig)."

msgid "This disk is too small ({have}; need {need})."
msgstr "Hierdie skyf is te klein ({have}; {need} word benodig)."

msgid "Could not write the boot partition."
msgstr "Kon nie die selflaaipartisie skryf nie."

msgid "Could not find the First Boot system partition."
msgstr "Kon nie die First Boot-stelselpartisie vind nie."

msgid "The image file is missing."
msgstr "Die beeldlêer ontbreek."

msgid "The image is damaged. It does not match the checksum."
msgstr "Die beeld is beskadig. Dit pas nie by die kontrolesom nie."

msgid "The image path is not a staged ISO."
msgstr "Die beeldpad is nie ’n voorbereide ISO nie."

msgid "Cannot gain permission to install."
msgstr "Kan nie toestemming kry om te installeer nie."

msgid "This edition has no image file name."
msgstr "Hierdie uitgawe het geen beeldlêernaam."

msgid "The image size does not match the catalog."
msgstr "Die beeldgrootte pas nie by die katalogus nie."

msgid "The download address is not valid."
msgstr "Die aflaai-adres is ongeldig."

msgid "The catalog checksum is not valid."
msgstr "Die katalogus-kontrolesom is ongeldig."

msgid "Not enough space for this image (need about {size} GB free)."
msgstr "Nie genoeg spasie vir hierdie beeld nie (sowat {size} GB vrye spasie word benodig)."
