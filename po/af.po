msgstr "Kontroleer die installasie"

msgid "Removing First Boot"
msgstr "Verwyder First Boot"

msgid "Restarting"
msgstr "Herbegin"

msgid "The install could not be checked."
msgstr "Die installasie kon nie gekontroleer word nie."

msgid "{name} is ready. This computer will restart."
msgstr "{name} is gereed. Hierdie rekenaar sal herbegin."

msgid "Could not copy First Boot into memory. Plug in a First Boot USB and try again."
msgstr "Kon First Boot nie na geheue kopieer nie. Prop ’n First Boot-USB in en probeer weer."

msgid "This computer could not stop using the disk. Restart and try again."
msgstr "Hierdie rekenaar kon nie ophou om die skyf te gebruik nie. Herbegin en probeer weer."
