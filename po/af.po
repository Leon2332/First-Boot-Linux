msgstr "Skyfbeeld"

msgid "USB stick"
msgstr "USB-stokkie"

msgid "Refresh"
msgstr "Verfris"

msgid "Your disk will be formatted. All data will be permanently erased."
msgstr "Jou skyf word geformateer. Alle data sal permanent uitgevee word."

msgid "Continue"
msgstr "Gaan voort"

msgid "Enter the shop name."
msgstr "Voer die winkelnaam in."

msgid "Enter a support contact."
msgstr "Voer ’n hulpraadkontak in."

msgid "Set a support password, or tick the VM option."
msgstr "Stel ’n hulpraadwagwoord, of merk die VM-opsie."

msgid "Use at least 6 characters."
msgstr "Gebruik minstens 6 karakters."

msgid "Tick at least one desktop to keep on the USB."
msgstr "Merk minstens een werkskerm om op die USB te hou."

msgid "No First Boot seed on this computer."
msgstr "Geen First Boot-saad op hierdie rekenaar."

msgid "Choose a USB stick."
msgstr "Kies ’n USB-stokkie."

msgid "Choose a USB stick"
msgstr "Kies ’n USB-stokkie"

msgid "Choose where to save the disk image."
msgstr "Kies waar om die skyfbeeld te stoor."

msgid "{size} · on the USB"
msgstr "{size} · op die USB"

msgid "Install support is not ready"
msgstr "Installasie-ondersteuning is nie gereed nie"

